{
  "datasets": [
    {
      "name": "scorecard",
      "displayName": "Scorecard",
      "queryLines": [
        "SELECT title AS agent, domain, owner, status, pass_rate, questions_7d, thumbs_down_rate_7d, sql_failure_rate_7d, last_run_ts, is_synthetic FROM v_fleet_scorecard WHERE target = 'prod'"
      ]
    },
    {
      "name": "kpis",
      "displayName": "Kpis",
      "queryLines": [
        "SELECT COUNT_IF(managed_as_code) AS managed, COUNT_IF(NOT managed_as_code) AS unmanaged, (SELECT COUNT_IF(status = 'Needs attention') FROM v_fleet_scorecard WHERE target = 'prod') AS needs_attention, (SELECT AVG(pass_rate) FROM v_fleet_scorecard WHERE target = 'prod') AS avg_pass_rate FROM v_agent_coverage"
      ]
    },
    {
      "name": "bench_trend",
      "displayName": "Bench Trend",
      "queryLines": [
        "SELECT title AS agent, DATE(run_ts) AS day, AVG(pass_rate) AS pass_rate FROM v_benchmark_trend WHERE target = 'prod' GROUP BY ALL"
      ]
    },
    {
      "name": "feedback_trend",
      "displayName": "Feedback Trend",
      "queryLines": [
        "SELECT title AS agent, day, thumbs_down_rate, questions FROM v_feedback_daily WHERE day >= current_date() - 30"
      ]
    },
    {
      "name": "review_queue",
      "displayName": "Review Queue",
      "queryLines": [
        "SELECT title AS agent, question, COUNT(*) AS times_thumbed_down, MAX(message_ts) AS last_seen FROM v_review_queue GROUP BY ALL"
      ]
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "queryLines": [
        "SELECT agent, CASE WHEN managed_as_code THEN 'Managed as code' ELSE 'Not managed' END AS management, queries_30d FROM v_agent_coverage"
      ]
    },
    {
      "name": "sql_health",
      "displayName": "Sql Health",
      "queryLines": [
        "SELECT title AS agent, SUM(queries) AS queries, SUM(failed_queries) AS failed, TRY_DIVIDE(SUM(failed_queries), SUM(queries)) AS failure_rate, AVG(p50_ms) AS p50_ms, SUM(warehouse_task_hours) AS warehouse_task_hours FROM v_sql_health WHERE title IS NOT NULL GROUP BY ALL"
      ]
    },
    {
      "name": "edits",
      "displayName": "Edits",
      "queryLines": [
        "SELECT event_time, title AS agent, edited_by, action_name FROM v_prod_edits_outside_pipeline"
      ]
    }
  ],
